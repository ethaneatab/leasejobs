# Copy to .env if you want to override defaults. Placeholder values only.
LEASEJOBS_DSN=postgresql://leasejobs:leasejobs-dev@127.0.0.1:54311/leasejobs
# owner=key pairs seeded by `python -m leasejobs.seed` (local dev placeholders)
LEASEJOBS_DEV_KEYS=alice=dev-key-alice,bob=dev-key-bob
LEASEJOBS_LEASE_TTL_S=4
LEASEJOBS_HEARTBEAT_S=1
# Switch a protection off on purpose (failing controls): no_reclaim,no_fencing,no_skip_locked
LEASEJOBS_LAB_SABOTAGE=
